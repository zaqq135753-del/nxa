{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/build-cloud.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/apresentacao",
      "destination": "/index.html"
    },
    {
      "source": "/parceiros/apresentacao",
      "destination": "/index.html"
    },
    {
      "source": "/parceiros/magic",
      "destination": "/index.html"
    },
    {
      "source": "/guia/pedidos",
      "destination": "/index.html"
    },
    {
      "source": "/guia/checkout/:businessId",
      "destination": "/index.html"
    },
    {
      "source": "/business",
      "destination": "/index.html"
    },
    {
      "source": "/business/",
      "destination": "/index.html"
    },
    {
      "source": "/parceiros/painel",
      "destination": "/index.html"
    },
    {
      "source": "/parceiros/painel/",
      "destination": "/index.html"
    },
    {
      "source": "/parceiros/painel-classico",
      "destination": "/index.html"
    },
    {
      "source": "/parceiros/cadastro",
      "destination": "/index.html"
    },
    {
      "source": "/parceiros/cadastro/",
      "destination": "/index.html"
    },
    {
      "source": "/guia",
      "destination": "/index.html"
    },
    {
      "source": "/guia/",
      "destination": "/index.html"
    },
    {
      "source": "/guia/viagem",
      "destination": "/index.html"
    },
    {
      "source": "/experience",
      "destination": "/index.html"
    },
    {
      "source": "/hospede",
      "destination": "/index.html"
    },
    {
      "source": "/admin/radar",
      "destination": "/index.html"
    },
    {
      "source": "/demonstracao/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/entregas",
      "destination": "/index.html"
    },
    {
      "source": "/motoboy",
      "destination": "/index.html"
    },
    {
      "source": "/entregador",
      "destination": "/index.html"
    },
    {
      "source": "/rider",
      "destination": "/index.html"
    },
    {
      "source": "/delivery",
      "destination": "/index.html"
    },
    {
      "source": "/delivery/",
      "destination": "/index.html"
    },
    {
      "source": "/ifood",
      "destination": "/index.html"
    },
    {
      "source": "/navegacao",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.open-meteo.com https://maps.googleapis.com https://maps.gstatic.com https://*.googleapis.com https://*.google.com https://ixqmvogmjvgmafmbbgli.supabase.co wss://ixqmvogmjvgmafmbbgli.supabase.co; media-src 'self' blob:; worker-src 'self' blob:; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
